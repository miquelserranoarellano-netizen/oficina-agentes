# Copia este archivo como .env y rellena lo que necesites. El .env nunca se sube al repositorio.
# Sin .env todo funciona en local: la oficina usa agentes simulados hasta que pongas una clave de IA.

# --- Servidor ---
# Dirección y puerto de la API. En el VPS se queda en 127.0.0.1: solo Caddy da la cara.
API_HOST=127.0.0.1
API_PORT=3001
# La cookie de sesión solo viaja por HTTPS. «localhost» cuenta como seguro, así que en local funciona.
# Pon false solo para probar desde el móvil por la wifi con http://192.168.x.x (nunca en el VPS).
COOKIE_SECURE=true
# Carpeta de la base de datos SQLite (por defecto, data/ dentro del proyecto)
# DATA_DIR=
# LOG_LEVEL=info

# --- Proveedor de IA ---
# gemini (por defecto, con plan gratuito) | groq | openrouter | ollama | anthropic | simulado
# «simulado» no llama a nadie ni gasta nada: sirve para probar el circuito completo.
LLM_PROVIDER=gemini
# Vacío = el modelo por defecto del proveedor:
#   gemini: gemini-3.5-flash-lite · groq: openai/gpt-oss-120b · openrouter: openrouter/free
#   ollama: llama3.2 · anthropic: claude-opus-5-5 (de pago; más barato: claude-haiku-5-5)
LLM_MODEL=

# Proveedor o modelo distinto para un agente (ALEX, LEO, NORA, IVAN, SARA, HUGO), opcional:
# LLM_PROVIDER_LEO=groq
# LLM_MODEL_LEO=openai/gpt-oss-120b

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
ANTHROPIC_API_KEY=

# --- Límites y ritmo ---
# Al llegar a cualquiera de los dos, la IA se para hasta el día siguiente (las tareas esperan en cola).
LIMITE_LLAMADAS_DIA=50
LIMITE_GASTO_DIA_USD=1.00
# Zona horaria con la que se cuenta «hoy»
ZONA_HORARIA=Europe/Madrid
# Minutos mínimos entre dos rondas del piloto automático del CEO
RITMO_CEO_MIN=20
# Precio en dólares por millón de tokens, si quieres que cuente el gasto de un modelo que no conoce
# (por ejemplo, Gemini con facturación activada). Los gratuitos cuentan 0.
# LLM_PRECIO_ENTRADA=
# LLM_PRECIO_SALIDA=

# --- Carpetas ---
# Carpeta con tus proyectos (SOLO LECTURA) para que los agentes tengan contexto.
# En local, «..» es la carpeta Proyectos del vault. En el VPS, déjalo vacío o apunta a una copia.
# PROYECTOS_DIR=..
# Donde los agentes guardan su trabajo (por defecto, resultados/ dentro del proyecto)
# RESULTADOS_DIR=
