{
  "name": "oficina-agentes",
  "version": "0.1.0",
  "private": true,
  "description": "Oficina de Miquel: un equipo de agentes de IA dirigido por un CEO, dibujado como una oficina en pixel art",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:server:dev\"",
    "server:dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "crear-usuario": "node --env-file-if-exists=.env server/crear-usuario.ts",
    "copia": "node --env-file-if-exists=.env server/copia.ts",
    "check": "tsc -b"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.7",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
